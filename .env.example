# Artify Platform API — environment configuration.
# Copy to .env for local development. See docs/ENVIRONMENT_CONFIGURATION.md
# for what each variable does and docs/DEVELOPMENT_SETUP.md for local setup.
#
# SECURITY: never commit a real value for any secret below. The app
# validates all of this at startup (server/config/env.ts) and refuses to
# boot if anything required is missing or a known-compromised value is
# reused — see docs/SECURITY_MODEL.md finding S3/S4/R3/R4.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Local dev: run `docker compose up -d db` (or
# a local Postgres install) then see docs/DATABASE_SETUP.md.
DATABASE_URL="postgresql://artify_dev:CHANGE_ME@localhost:5432/artify_dev?schema=public"

# Session signing/derivation secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 16 chars (dev), minimum 32 chars enforced in production/staging.
SESSION_SECRET=

# Cookie domain for future cookie-based sessions (Phase 3). Leave unset in
# single-domain local dev.
COOKIE_DOMAIN=

# Comma-separated list of allowed browser origins (no wildcard in prod).
# Example: https://artifysols.com,https://admin.artifysols.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=info

# Webhook HMAC signing secret.
# RENAMED from the Phase 0 prototype's ARTIFY_WEBHOOK_SECRET — that
# variable's committed default value (artify_whsec_prod_2026_soc2) is
# COMPROMISED (it was hardcoded in source and shipped to the browser).
# Generate a fresh value and never reuse the old one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# AI provider. "gemini" requires GEMINI_API_KEY; "none" disables AI
# endpoints without failing startup.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Object storage (Phase 9 — docs/STORAGE_PROVIDER_ARCHITECTURE.md).
# "none" selects the local-filesystem provider — development/test only,
# REJECTED at startup in production/staging (server/config/env.ts). Set a
# real provider (s3, r2, or supabase) before deploying.
OBJECT_STORAGE_PROVIDER=none
OBJECT_STORAGE_BUCKET=

# Required when OBJECT_STORAGE_PROVIDER=s3 or r2 (one shared S3-compatible
# provider implementation backs both). OBJECT_STORAGE_ENDPOINT is required
# for r2 (the account's R2 S3 API endpoint), optional for s3 (only needed
# to target a non-AWS S3-compatible host). OBJECT_STORAGE_FORCE_PATH_STYLE
# should be "true" for r2/MinIO-style endpoints.
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_FORCE_PATH_STYLE=false

# Required when OBJECT_STORAGE_PROVIDER=supabase — the established
# production target for this project (docs/SUPABASE_DATABASE_SETUP.md).
# SUPABASE_STORAGE_SERVICE_ROLE_KEY is server-side only; it is never sent
# to the browser and must never be placed in a VITE_-prefixed variable.
SUPABASE_STORAGE_URL=
SUPABASE_STORAGE_SERVICE_ROLE_KEY=

# Local-filesystem provider's storage directory (OBJECT_STORAGE_PROVIDER=none
# only) — relative to the process working directory, gitignored, never used
# in production.
LOCAL_STORAGE_DIR=.local-storage

# Centralized upload limits (bytes) and signed-URL/upload-session lifetimes.
MEDIA_MAX_IMAGE_SIZE_BYTES=10485760
MEDIA_MAX_DOCUMENT_SIZE_BYTES=26214400
MEDIA_SIGNED_URL_TTL_SECONDS=900
MEDIA_UPLOAD_SESSION_TTL_MINUTES=15

# Phase 11 — the agency organization the public website (artifysolscom)
# reads its published pages/posts/products from and creates public leads
# under. Leave unset to disable public content/lead intake rather than
# guess a tenant — see docs/PUBLIC_API_ARCHITECTURE.md.
PUBLIC_WEBSITE_ORGANIZATION_ID=
