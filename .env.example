# Artify Platform API — environment configuration.
# Copy to .env for local development. See docs/ENVIRONMENT_CONFIGURATION.md
# for what each variable does and docs/DEVELOPMENT_SETUP.md for local setup.
#
# SECURITY: never commit a real value for any secret below. The app
# validates all of this at startup (server/config/env.ts) and refuses to
# boot if anything required is missing or a known-compromised value is
# reused — see docs/SECURITY_MODEL.md finding S3/S4/R3/R4.

NODE_ENV=development
PORT=3000

# PostgreSQL connection string. Local dev: run `docker compose up -d db` (or
# a local Postgres install) then see docs/DATABASE_SETUP.md.
DATABASE_URL="postgresql://artify_dev:CHANGE_ME@localhost:5432/artify_dev?schema=public"

# Session signing/derivation secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Minimum 16 chars (dev), minimum 32 chars enforced in production/staging.
SESSION_SECRET=

# Cookie domain for future cookie-based sessions (Phase 3). Leave unset in
# single-domain local dev.
COOKIE_DOMAIN=

# Comma-separated list of allowed browser origins (no wildcard in prod).
# Example: https://artifysols.com,https://admin.artifysols.com
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

LOG_LEVEL=info

# Webhook HMAC signing secret.
# RENAMED from the Phase 0 prototype's ARTIFY_WEBHOOK_SECRET — that
# variable's committed default value (artify_whsec_prod_2026_soc2) is
# COMPROMISED (it was hardcoded in source and shipped to the browser).
# Generate a fresh value and never reuse the old one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# AI provider. "gemini" requires GEMINI_API_KEY; "none" disables AI
# endpoints without failing startup.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Object storage (Phase 9 — not yet implemented, "none" is the only valid
# value until then).
OBJECT_STORAGE_PROVIDER=none
OBJECT_STORAGE_BUCKET=
