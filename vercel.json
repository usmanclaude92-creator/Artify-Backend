{
  "regions": [
    "hnd1"
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.mjs": {
      "includeFiles": "node_modules/.prisma/client/**",
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/v1/automation/internal/tick",
      "schedule": "0 0 * * *"
    }
  ]
}
